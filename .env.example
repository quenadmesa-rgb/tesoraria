# Copie este ficheiro para ".env" (nunca o envie para o GitHub) e preencha.

# MySQL na nuvem (ex.: Aiven ou TiDB Cloud): copie o "connection string" do painel do serviço.
DATABASE_URL=mysql://utilizador:senha@servidor:porta/tesouraria

# MySQL local (no seu PC): use estas duas linhas em vez da de cima.
# DATABASE_URL=mysql://root:SUA_SENHA@localhost:3306/tesouraria
# DB_SSL=false

# Texto longo e aleatório (mínimo 32 caracteres) para assinar as sessões.
AUTH_SECRET=troque-isto-por-um-texto-longo-e-aleatorio-com-mais-de-32-caracteres
